{
  "name": "traxo",
  "version": "0.1.0",
  "private": true,
  "description": "Traxo: agente open source que opera tu e-commerce en Colombia (envíos, tracking, marketing y clientes) dentro de Claude.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "pnpm --filter @traxo/db generate",
    "db:seed": "pnpm --filter @traxo/db seed",
    "dev": "pnpm --filter @traxo/worker dev",
    "start": "tsx --env-file-if-exists=.env apps/worker/src/main.ts",
    "build": "pnpm db:generate && pnpm --filter @traxo/dashboard build",
    "dev:ui": "pnpm --filter @traxo/dashboard dev",
    "doctor": "node scripts/doctor.mjs",
    "railway:vars": "node scripts/railway-vars.mjs",
    "serve": "pnpm build && pnpm start",
    "configurar": "node scripts/setup.mjs",
    "demo:media": "node scripts/cargar-demo-media.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  },
  "homepage": "https://github.com/Hainrixz/traxo-agente#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hainrixz/traxo-agente.git"
  },
  "bugs": {
    "url": "https://github.com/Hainrixz/traxo-agente/issues"
  },
  "keywords": [
    "ecommerce",
    "colombia",
    "logistica",
    "shopify",
    "tiendanube",
    "contraentrega",
    "whatsapp",
    "claude-code",
    "mcp",
    "agent"
  ]
}
