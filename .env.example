# Traxo — variables de entorno. Copia este archivo a .env y completa SOLO lo que uses.
# Lo más fácil: en Claude Code corre /traxo:instalar y este archivo se crea solo (sin pegar llaves en el chat).
# Sin base de datos externa, Traxo usa PGlite local (sin Docker).

# --- Base de datos ---
# Vacío = PGlite local en .traxo-data/pg. En Railway se inyecta solo.
DATABASE_URL=

# --- Tienda (elige la tuya) ---
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_WEBHOOK_SECRET=
TIENDANUBE_STORE_ID=
TIENDANUBE_ACCESS_TOKEN=
TIENDANUBE_APP_SECRET=
WOOCOMMERCE_URL=
WOOCOMMERCE_KEY=
WOOCOMMERCE_SECRET=

# --- Envíos ---
ENVIA_TOKEN=
ENVIA_ENV=sandbox
NOVENTA_Y_NUEVE_ENVIOS_TOKEN=
COORDINADORA_API_KEY=
COORDINADORA_NIT=
SERVIENTREGA_USER=
SERVIENTREGA_PASSWORD=
INTERRAPIDISIMO_TOKEN=
ENVIA_CO_USER=
ENVIA_CO_PASSWORD=

# --- Mensajería ---
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=

# --- Agente (opcional): con esta llave el agente del panel responde en lenguaje libre (siempre con tus datos) ---
ANTHROPIC_API_KEY=
TRAXO_AGENT_MODEL=claude-sonnet-5-5
# Frenos de gasto de la IA (la llave nunca sale del servidor). TRAXO_AI=off la apaga.
TRAXO_AI=
TRAXO_AI_PER_MIN=6
TRAXO_AI_PER_STORE_DAILY=40
TRAXO_AI_GLOBAL_DAILY=500
# Peticiones por minuto y por IP a /api y /mcp.
TRAXO_RATE_PER_MIN=300

# --- Pagos (prepago con link) ---
WOMPI_PRIVATE_KEY=
WOMPI_ENV=sandbox
WOMPI_EVENTS_SECRET=

# --- Webhooks de transportadoras ---
ENVIA_WEBHOOK_SECRET=

# --- Origen de los envíos ---
ORIGIN_NAME=Mi Tienda
ORIGIN_PHONE=+573000000000
ORIGIN_STREET=Calle 1 # 1-1
ORIGIN_CITY=Bogotá
ORIGIN_DANE=11001

# --- Acceso ---
# Firma de las sesiones (en la nube define uno fijo; si no, se genera al arrancar y las sesiones se pierden al reiniciar).
TRAXO_SESSION_SECRET=
# Con una tienda real: la cuenta que entra al panel.
TRAXO_ADMIN_EMAIL=
TRAXO_ADMIN_PASSWORD=
# Token para scripts y para el MCP remoto.
TRAXO_API_TOKEN=
TRAXO_MCP_TOKEN=
# Permite auditar URLs públicas reales (nunca direcciones internas).
TRAXO_AUDIT_LIVE=
# Nombre y URL de tu tienda (se muestran en el panel).
TRAXO_STORE_NAME=
TRAXO_STORE_URL=

# --- Servidor ---
PORT=8787
# Dónde se guardan los videos y fotos que subes a la biblioteca de creativos (en Railway, usa un volumen).
TRAXO_MEDIA_DIR=.traxo-data/media
